<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="JGuard.Pages.StartupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Dark"
    Title="Where would you like to start?"
    CloseButtonText="Cancel"
    MinWidth="560">

    <StackPanel Spacing="12" Padding="8">
        <TextBlock Text="Choose a page to open. The Home interface requires an active chat session."
                   FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap"/>

        <!-- Home -->
        <Button x:Name="HomeButton" Click="HomeButton_Click"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Padding="16" CornerRadius="8">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE80F;" FontSize="22" Foreground="#05D9E8" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="Home (System Interface)" FontSize="15" FontWeight="SemiBold" Foreground="#F5F5F5"/>
                    <TextBlock Text="Chat with the LLM under active defenses. Opens the session manager first."
                               FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Button>

        <!-- Red Team -->
        <Button x:Name="RedTeamButton" Click="RedTeamButton_Click"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Padding="16" CornerRadius="8">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE73A;" FontSize="22" Foreground="#05D9E8" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="Red Team Dashboard" FontSize="15" FontWeight="SemiBold" Foreground="#F5F5F5"/>
                    <TextBlock Text="Launch and monitor automated attack campaigns. No session required."
                               FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Button>

        <!-- Evaluation -->
        <Button x:Name="EvaluationButton" Click="EvaluationButton_Click"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Padding="16" CornerRadius="8">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE9D9;" FontSize="22" Foreground="#05D9E8" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="Evaluation Dashboard" FontSize="15" FontWeight="SemiBold" Foreground="#F5F5F5"/>
                    <TextBlock Text="Review evaluation history and results. No session required."
                               FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Button>
    </StackPanel>
</ContentDialog>
