<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="JGuard.Pages.SessionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Dark"
    Title="Session Manager"
    PrimaryButtonText="Continue"
    SecondaryButtonText="Cancel"
    DefaultButton="Primary"
    MinWidth="600">

    <ContentDialog.Resources>
        <!-- Green "active" theming shared by the agent-defense toggle buttons.
             Defined at dialog scope so every plain ToggleButton inherits it; the
             "Activate All" button overrides these locally so it is unaffected. -->
        <SolidColorBrush x:Key="ToggleButtonBackground" Color="#1E293B"/>
        <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#27364B"/>
        <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#0F172A"/>
        <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#334155"/>
        <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#475569"/>
        <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="#334155"/>
        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#064E3B"/>
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#076049"/>
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#053E30"/>
        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#10B981"/>
        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="#10B981"/>
        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="#10B981"/>

        <Style x:Key="DefenseToggleStyle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </ContentDialog.Resources>

    <Grid>
        <ScrollViewer x:Name="MainContent">
            <StackPanel Spacing="16" Padding="16" HorizontalAlignment="Stretch">
                <!-- Instructions -->
                <TextBlock Text="Choose an existing session or create a new one" FontSize="14" Foreground="#94A3B8" TextWrapping="Wrap"/>
                
                <!-- Existing Sessions Section -->
                <StackPanel Spacing="8" HorizontalAlignment="Stretch">
                    <TextBlock Text="Existing Sessions" FontSize="12" FontWeight="SemiBold" Foreground="#05D9E8"/>
                    <ListBox x:Name="SessionsListBox" MaxHeight="350" SelectionMode="Single" 
                             HorizontalAlignment="Stretch" 
                             HorizontalContentAlignment="Stretch"
                             Padding="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local1:Session" xmlns:local1="using:JGuard.Models">
                                <Border Background="#1E293B" Padding="16" CornerRadius="8" 
                                        BorderBrush="#334155" BorderThickness="1" 
                                        HorizontalAlignment="Stretch">
                                    <Grid RowSpacing="12" HorizontalAlignment="Stretch">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Header: Model and Mode -->
                                        <Grid Grid.Row="0" HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Config.ModelDisplay}" FontWeight="Bold" Foreground="#05D9E8" FontSize="16" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Background="#0F172A" CornerRadius="4" Padding="8,4" VerticalAlignment="Center" BorderBrush="#334155" BorderThickness="1">
                                                <TextBlock Text="{x:Bind Config.ModeText}" FontSize="10" Foreground="#F5F5F5" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>

                                        <!-- Details: Source and Time -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE946;" FontSize="11" Foreground="#94A3B8"/>
                                                <TextBlock Text="{x:Bind Config.SourceText}" FontSize="11" Foreground="#94A3B8"/>
                                            </StackPanel>
                                            <TextBlock Text="|" Foreground="#334155" FontSize="11" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE823;" FontSize="11" Foreground="#94A3B8"/>
                                                <TextBlock Text="{x:Bind LastActiveDisplay}" FontSize="11" Foreground="#94A3B8">
                                                    <ToolTipService.ToolTip>
                                                        <TextBlock Text="{x:Bind LastActiveFull}" TextWrapping="Wrap"/>
                                                    </ToolTipService.ToolTip>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Protections Badges -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                                            <Border CornerRadius="12" Padding="10,3" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" 
                                                    Visibility="{x:Bind Config.ObfuscationVisibility}">
                                                <TextBlock Text="Obfuscation" FontSize="10" Foreground="#ECFDF5"/>
                                            </Border>
                                            <Border CornerRadius="12" Padding="10,3" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" 
                                                    Visibility="{x:Bind Config.MultiTurnVisibility}">
                                                <TextBlock Text="Multi-Turn" FontSize="10" Foreground="#ECFDF5"/>
                                            </Border>
                                            <Border CornerRadius="12" Padding="10,3" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" 
                                                    Visibility="{x:Bind Config.RoleplayVisibility}">
                                                <TextBlock Text="Roleplay" FontSize="10" Foreground="#ECFDF5"/>
                                            </Border>
                                            <Border CornerRadius="12" Padding="10,3" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1"
                                                    Visibility="{x:Bind Config.PiiVisibility}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="PII:" FontSize="10" Foreground="#ECFDF5"/>
                                                    <TextBlock Text="{x:Bind Config.PiiStrategy}" FontSize="10" Foreground="#A7F3D0" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                            <Border CornerRadius="12" Padding="10,3" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1"
                                                    Visibility="{x:Bind Config.WebSearchVisibility}">
                                                <TextBlock Text="Web Search" FontSize="10" Foreground="#ECFDF5"/>
                                            </Border>
                                            <Border CornerRadius="12" Padding="10,3" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1"
                                                    Visibility="{x:Bind Config.CodeExecutionVisibility}">
                                                <TextBlock Text="Code Exec" FontSize="10" Foreground="#ECFDF5"/>
                                            </Border>
                                            <Border CornerRadius="12" Padding="10,3" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1"
                                                    Visibility="{x:Bind Config.RagVisibility}">
                                                <TextBlock Text="RAG" FontSize="10" Foreground="#ECFDF5"/>
                                            </Border>
                                            <Border CornerRadius="12" Padding="10,3" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1"
                                                    Visibility="{x:Bind Config.EmailVisibility}">
                                                <TextBlock Text="Email" FontSize="10" Foreground="#ECFDF5"/>
                                            </Border>
                                            <Border CornerRadius="12" Padding="10,3" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1"
                                                    Visibility="{x:Bind Config.DocumentVisibility}">
                                                <TextBlock Text="Document" FontSize="10" Foreground="#ECFDF5"/>
                                            </Border>

                                            <!-- Placeholder if no defenses enabled -->
                                            <TextBlock Text="No defenses active" FontSize="10" Foreground="#64748B" FontStyle="Italic"
                                                       Visibility="{x:Bind Config.NoDefensesVisibility}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- ID Footer -->
                                        <TextBlock Grid.Row="3" Text="{x:Bind SessionId}" FontSize="9" Foreground="#475569" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button x:Name="DeleteSessionButton" Content="Delete Selected" HorizontalAlignment="Right" FontSize="11" Click="DeleteSessionButton_Click" Visibility="Collapsed" Background="#DC2626" Foreground="#FFFFFF" BorderBrush="#991B1B"/>
                </StackPanel>

                <!-- Divider -->
                <TextBlock Text="— OR —" HorizontalAlignment="Center" Foreground="#64748B" FontSize="12"/>

                <!-- New Session Section -->
                <StackPanel Spacing="12" Padding="12" Background="#1E293B" CornerRadius="8">
                    <TextBlock Text="Create New Session" FontSize="12" FontWeight="SemiBold" Foreground="#05D9E8"/>
                    
                    <!-- Chat Mode -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Chat Mode" FontSize="11" Foreground="#94A3B8"/>
                        <ComboBox x:Name="ChatModeCombo" SelectedIndex="0">
                            <ComboBoxItem>Foundational</ComboBoxItem>
                            <ComboBoxItem>Agent</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <!-- LLM Source (foundational only) -->
                    <StackPanel x:Name="LLMSourcePanel" Spacing="4">
                        <TextBlock Text="LLM Source" FontSize="11" Foreground="#94A3B8"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <RadioButton x:Name="RadioOpenSource" Content="Open Source" Foreground="#F5F5F5"/>
                            <RadioButton x:Name="RadioClosedSource" Content="Closed Source" Foreground="#F5F5F5"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- LLM Model (foundational only) -->
                    <StackPanel x:Name="LLMModelPanel" Spacing="4">
                        <TextBlock Text="LLM Model" FontSize="11" Foreground="#94A3B8"/>
                        <TextBox x:Name="LLMTypeBox" PlaceholderText="e.g., qwen2.5:3b-instruct"/>
                    </StackPanel>

                    <!-- Agent note (agent mode only) -->
                    <Border x:Name="AgentNote" Background="#1A2233" BorderBrush="#05D9E8" BorderThickness="1" CornerRadius="6" Padding="10,8" Visibility="Collapsed">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE99A;" FontSize="13" Foreground="#05D9E8" VerticalAlignment="Top" Margin="0,1,0,0"/>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" Foreground="#BAE6FD" FontSize="11">
                                <Run FontWeight="SemiBold">Agent mode uses the backend's built-in agent.</Run>
                                <Run>No LLM source or model is required — just choose your defenses below.</Run>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Closed source provider note -->
                    <TextBlock x:Name="ClosedSourceNote"
                               Text="Supported providers: OpenAI and Gemini"
                               FontSize="11" Foreground="#F59E0B" FontStyle="Italic"
                               Visibility="Collapsed"/>

                    <!-- Open Source extras: optional custom base URL -->
                    <StackPanel x:Name="OpenSourceExtrasPanel" Spacing="8">
                        <!-- Open source note -->
                        <Border Background="#1C2A1A" BorderBrush="#4ADE80" BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE946;" FontSize="13" Foreground="#4ADE80" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                <TextBlock Grid.Column="1" TextWrapping="Wrap" Foreground="#BBF7D0" FontSize="11">
                                    <Run FontWeight="SemiBold">Open source models must be running locally before starting a session.</Run>
                                    <Run>Make sure your model is pulled and served (e.g. via Ollama) before clicking Continue.</Run>
                                    <Run>Or use a custom base URL.</Run>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <CheckBox x:Name="UseBaseUrlCheck" Content="Use custom LLM base URL" Foreground="#F5F5F5"/>
                        <StackPanel x:Name="LLMBaseUrlPanel" Spacing="4" Visibility="Collapsed">
                            <TextBlock Text="LLM Base URL" FontSize="11" Foreground="#94A3B8"/>
                            <TextBox x:Name="LLMBaseUrlBox" PlaceholderText="e.g., http://localhost:11434"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Closed Source extras: API key -->
                    <StackPanel x:Name="ApiKeyPanel" Spacing="4" Visibility="Collapsed">
                        <TextBlock Text="API Key" FontSize="11" Foreground="#94A3B8"/>
                        <PasswordBox x:Name="ApiKeyBox" PlaceholderText="Enter your API key"/>
                    </StackPanel>

                    <!-- Defenses -->
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Defenses" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" x:Name="ActivateAllDefensesButton"
                                          Checked="ActivateAllDefensesButton_Checked"
                                          Unchecked="ActivateAllDefensesButton_Unchecked"
                                          Padding="10,4" BorderThickness="1" CornerRadius="6">
                                <ToggleButton.Resources>
                                    <!-- Unchecked (neutral slate) -->
                                    <SolidColorBrush x:Key="ToggleButtonBackground" Color="#1E293B"/>
                                    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#27364B"/>
                                    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#0F172A"/>
                                    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#334155"/>
                                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#475569"/>
                                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="#334155"/>
                                    <!-- Checked (green active) -->
                                    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#064E3B"/>
                                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#076049"/>
                                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#053E30"/>
                                    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#10B981"/>
                                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="#10B981"/>
                                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="#10B981"/>
                                </ToggleButton.Resources>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon x:Name="ActivateAllIcon" Glyph="&#xE73E;" FontSize="11" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="ActivateAllText" Text="Activate All" FontSize="11" Foreground="#94A3B8"/>
                                </StackPanel>
                            </ToggleButton>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <CheckBox x:Name="ObfuscationCheck" Content="Obfuscation" Foreground="#F5F5F5"/>
                            <CheckBox x:Name="MultiTurnCheck" Content="Multi-Turn" Foreground="#F5F5F5"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <CheckBox x:Name="RoleplayCheck" Content="Roleplay" Foreground="#F5F5F5"/>
                            <CheckBox x:Name="PiiCheck" Content="PII Protection" Foreground="#F5F5F5"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- PII Strategy -->
                    <StackPanel x:Name="PiiStrategyPanel" Spacing="4" Visibility="Collapsed">
                        <TextBlock Text="PII Strategy" FontSize="11" Foreground="#94A3B8"/>
                        <ComboBox x:Name="PiiStrategyCombo" SelectedIndex="0">
                            <ComboBoxItem Tag="mask">Mask</ComboBoxItem>
                            <ComboBoxItem Tag="hash">Hash</ComboBoxItem>
                            <ComboBoxItem Tag="block">Block</ComboBoxItem>
                            <ComboBoxItem Tag="partial">Partial</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <!-- Agent Defenses (agent mode only) -->
                    <StackPanel x:Name="AgentDefensesPanel" Spacing="8" Visibility="Collapsed">
                        <MenuFlyoutSeparator Background="#19FFFFFF"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Agent Defenses" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" x:Name="ActivateAllAgentButton"
                                          Checked="ActivateAllAgentButton_Checked"
                                          Unchecked="ActivateAllAgentButton_Unchecked"
                                          Padding="10,4" BorderThickness="1" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon x:Name="ActivateAllAgentIcon" Glyph="&#xE73E;" FontSize="11" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="ActivateAllAgentText" Text="Activate All" FontSize="11" Foreground="#94A3B8"/>
                                </StackPanel>
                            </ToggleButton>
                        </Grid>
                        <TextBlock Text="Extra protections available to agent sessions." FontSize="10" Foreground="#64748B" TextWrapping="Wrap"/>
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ToggleButton Grid.Row="0" Grid.Column="0" x:Name="WebSearchDefenseToggle" Style="{StaticResource DefenseToggleStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE774;" FontSize="13" Foreground="#F5F5F5"/>
                                    <TextBlock Text="Web Search" FontSize="12" Foreground="#F5F5F5"/>
                                </StackPanel>
                            </ToggleButton>

                            <ToggleButton Grid.Row="0" Grid.Column="1" x:Name="CodeExecutionDefenseToggle" Style="{StaticResource DefenseToggleStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE943;" FontSize="13" Foreground="#F5F5F5"/>
                                    <TextBlock Text="Code Execution" FontSize="12" Foreground="#F5F5F5"/>
                                </StackPanel>
                            </ToggleButton>

                            <ToggleButton Grid.Row="1" Grid.Column="0" x:Name="RagDefenseToggle" Style="{StaticResource DefenseToggleStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8F1;" FontSize="13" Foreground="#F5F5F5"/>
                                    <TextBlock Text="RAG" FontSize="12" Foreground="#F5F5F5"/>
                                </StackPanel>
                            </ToggleButton>

                            <ToggleButton Grid.Row="1" Grid.Column="1" x:Name="EmailDefenseToggle" Style="{StaticResource DefenseToggleStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE715;" FontSize="13" Foreground="#F5F5F5"/>
                                    <TextBlock Text="Email" FontSize="12" Foreground="#F5F5F5"/>
                                </StackPanel>
                            </ToggleButton>

                            <ToggleButton Grid.Row="2" Grid.Column="0" x:Name="DocumentDefenseToggle" Style="{StaticResource DefenseToggleStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="13" Foreground="#F5F5F5"/>
                                    <TextBlock Text="Document" FontSize="12" Foreground="#F5F5F5"/>
                                </StackPanel>
                            </ToggleButton>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <StackPanel x:Name="LoadingOverlay" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
            <ProgressRing IsActive="True" Width="60" Height="60" Foreground="#05D9E8"/>
            <TextBlock Text="Preparing session... This may take a moment." Foreground="#05D9E8" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</ContentDialog>
