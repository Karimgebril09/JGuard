<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="JGuard.Pages.RedTeamPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:JGuard.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Dark">

    <Grid Background="#020617" Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20" Spacing="4">
            <TextBlock Text="Red Team Dashboard" Style="{StaticResource HeaderTextBlockStyle}" Foreground="#FF2D55" FontWeight="Bold"/>
            <TextBlock Text="Configure and execute automated adversarial vulnerability testing on target AI systems." Style="{StaticResource BodyTextBlockStyle}" Foreground="#94A3B8"/>
        </StackPanel>

        <!-- Main Workspace -->
        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left column: Configuration Panel -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">

                    <!-- Attack Strategy Section -->
                    <Border Background="#111827" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7E8;" Foreground="#FF2D55" FontSize="18"/>
                                <TextBlock Text="Attack Strategy" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Pivot x:Name="StrategyPivot" SelectionChanged="StrategyPivot_SelectionChanged">

                                <!-- Tab 1: Custom ATJ -->
                                <PivotItem Header="Custom ATJ">
                                    <StackPanel Spacing="12" Margin="0,10,0,0">
                                        <TextBlock Text="Automated Attacker-Target-Judge loop with custom attack type and model configuration." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap"/>

                                        <!-- Attack type + num samples side by side -->
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="130"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Attack Type" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                                                <ComboBox x:Name="ComboAttackType" HorizontalAlignment="Stretch" SelectedIndex="0">
                                                    <ComboBoxItem Content="Role Playing" Tag="role_playing"/>
                                                    <ComboBoxItem Content="Obfuscation" Tag="obfuscation"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="Num Samples" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                                                <NumberBox x:Name="NumSamplesCustom" Value="5" Minimum="1" Maximum="100" SpinButtonPlacementMode="Compact" SmallChange="1" HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Harm Category" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                                            <ComboBox x:Name="ComboHarmType" HorizontalAlignment="Stretch" PlaceholderText="Select harm category..." FontSize="12">
                                                <ComboBoxItem Content="Copyright Infringement / Breaking Law" Tag="copyright infringement_breaking_law"/>
                                                <ComboBoxItem Content="Data Exposure" Tag="data_exposure"/>
                                                <ComboBoxItem Content="Hallucination" Tag="hallucination"/>
                                                <ComboBoxItem Content="Hate Speech" Tag="hate_speech"/>
                                                <ComboBoxItem Content="Information Extraction / Model Inversion" Tag="information_extraction_model_inversion"/>
                                                <ComboBoxItem Content="Offensive Content" Tag="offensive_content"/>
                                                <ComboBoxItem Content="Performance Degradation / DoS" Tag="performance_degradation_DOS"/>
                                                <ComboBoxItem Content="Scam / Phishing Content" Tag="scam_phishing_content"/>
                                                <ComboBoxItem Content="Unauthorized Access / Privilege Escalation" Tag="unauthorized_access_privilege_escalation"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <MenuFlyoutSeparator Background="#19FFFFFF"/>

                                        <!-- Attacker Model -->
                                        <Border Background="#0D1117" CornerRadius="6" Padding="10">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="ATTACKER MODEL" FontSize="10" FontWeight="Bold" Foreground="#FF2D55" CharacterSpacing="100"/>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="ComboAttackerType" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="AttackerType_Changed">
                                                        <ComboBoxItem Content="Ollama" Tag="ollama"/>
                                                        <ComboBoxItem Content="OpenAI" Tag="openai"/>
                                                        <ComboBoxItem Content="Gemini" Tag="gemini"/>
                                                    </ComboBox>
                                                    <TextBox Grid.Column="1" x:Name="TextAttackerModel" PlaceholderText="model name" FontSize="12"/>
                                                </Grid>
                                                <PasswordBox x:Name="PwdAttackerKey" PlaceholderText="API Key" FontSize="12" Visibility="Collapsed"/>
                                                <TextBox x:Name="TextAttackerUrl" PlaceholderText="Base URL (optional)" FontSize="12"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Target Model -->
                                        <Border Background="#0D1117" CornerRadius="6" Padding="10">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="TARGET MODEL" FontSize="10" FontWeight="Bold" Foreground="#FFB800" CharacterSpacing="100"/>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="ComboTargetType" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="CustomTargetType_Changed">
                                                        <ComboBoxItem Content="Ollama" Tag="ollama"/>
                                                        <ComboBoxItem Content="OpenAI" Tag="openai"/>
                                                        <ComboBoxItem Content="Gemini" Tag="gemini"/>
                                                    </ComboBox>
                                                    <TextBox Grid.Column="1" x:Name="TextTargetModel" PlaceholderText="model name" FontSize="12"/>
                                                </Grid>
                                                <PasswordBox x:Name="PwdTargetKey" PlaceholderText="API Key" FontSize="12" Visibility="Collapsed"/>
                                                <TextBox x:Name="TextTargetUrl" PlaceholderText="Base URL (optional)" FontSize="12"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Judge Model -->
                                        <Border Background="#0D1117" CornerRadius="6" Padding="10">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="JUDGE MODEL" FontSize="10" FontWeight="Bold" Foreground="#22FF88" CharacterSpacing="100"/>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="ComboJudgeType" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="JudgeType_Changed">
                                                        <ComboBoxItem Content="Ollama" Tag="ollama"/>
                                                        <ComboBoxItem Content="OpenAI" Tag="openai"/>
                                                        <ComboBoxItem Content="Gemini" Tag="gemini"/>
                                                    </ComboBox>
                                                    <TextBox Grid.Column="1" x:Name="TextJudgeModel" PlaceholderText="model name" FontSize="12"/>
                                                </Grid>
                                                <PasswordBox x:Name="PwdJudgeKey" PlaceholderText="API Key" FontSize="12" Visibility="Collapsed"/>
                                                <TextBox x:Name="TextJudgeUrl" PlaceholderText="Base URL (optional)" FontSize="12"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </PivotItem>

                                <!-- Tab 2: Tool-Based -->
                                <PivotItem Header="Tool-Based">
                                    <StackPanel Spacing="12" Margin="0,10,0,0">
                                        <TextBlock Text="Run preset attack suites via an industry-standard framework against your target model." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap"/>

                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Framework" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                                            <ComboBox x:Name="ComboToolFramework" HorizontalAlignment="Stretch" SelectedIndex="0">
                                                <ComboBoxItem Content="promptfoo — LLM evaluation &amp; security bench" Tag="promptfoo"/>
                                                <ComboBoxItem Content="garak — LLM vulnerability scanner" Tag="garak"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Target Model -->
                                        <Border Background="#0D1117" CornerRadius="6" Padding="10">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="TARGET MODEL" FontSize="10" FontWeight="Bold" Foreground="#FFB800" CharacterSpacing="100"/>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="ComboToolTargetType" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="ToolTargetType_Changed">
                                                        <ComboBoxItem Content="Ollama" Tag="ollama"/>
                                                        <ComboBoxItem Content="OpenAI" Tag="openai"/>
                                                        <ComboBoxItem Content="Gemini" Tag="gemini"/>
                                                    </ComboBox>
                                                    <TextBox Grid.Column="1" x:Name="TextToolTargetModel" PlaceholderText="model name" FontSize="12"/>
                                                </Grid>
                                                <PasswordBox x:Name="PwdToolTargetKey" PlaceholderText="API Key" FontSize="12" Visibility="Collapsed"/>
                                                <TextBox x:Name="TextToolTargetUrl" PlaceholderText="Base URL (optional)" FontSize="12"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </PivotItem>
                            </Pivot>
                        </StackPanel>
                    </Border>

                    <!-- Protection Options -->
                    <Border x:Name="ProtectionOptionsCard" Background="#111827" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE811;" Foreground="#FFB800" FontSize="18"/>
                                    <TextBlock Text="Protection Options" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" x:Name="ActivateAllDefensesButton"
                                              VerticalAlignment="Center"
                                              Checked="ActivateAllDefensesButton_Checked"
                                              Unchecked="ActivateAllDefensesButton_Unchecked"
                                              Padding="10,4" BorderThickness="1" CornerRadius="6">
                                    <ToggleButton.Resources>
                                        <!-- Unchecked (neutral slate) -->
                                        <SolidColorBrush x:Key="ToggleButtonBackground" Color="#1E293B"/>
                                        <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#27364B"/>
                                        <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#0F172A"/>
                                        <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#334155"/>
                                        <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#475569"/>
                                        <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="#334155"/>
                                        <!-- Checked (green active) -->
                                        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#064E3B"/>
                                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#076049"/>
                                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#053E30"/>
                                        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#10B981"/>
                                        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="#10B981"/>
                                        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="#10B981"/>
                                    </ToggleButton.Resources>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon x:Name="ActivateAllIcon" Glyph="&#xE73E;" FontSize="11" Foreground="#94A3B8"/>
                                        <TextBlock x:Name="ActivateAllText" Text="Activate All" FontSize="11" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </ToggleButton>
                            </Grid>
                            <TextBlock Text="Activate defenses on the target model during the campaign:" FontSize="12" Foreground="#94A3B8"/>

                            <MenuFlyoutSeparator Background="#19FFFFFF"/>

                            <ToggleSwitch x:Name="ToggleObfuscation" Header="Obfuscation Protection" IsOn="False" OnContent="Enabled" OffContent="Disabled"/>
                            <ToggleSwitch x:Name="ToggleRoleplay" Header="Roleplay Protection" IsOn="False" OnContent="Enabled" OffContent="Disabled"/>
                            <ToggleSwitch x:Name="ToggleMultiTurn" Header="Multi-Turn Protection" IsOn="False" OnContent="Enabled" OffContent="Disabled"/>
                            <ToggleSwitch x:Name="TogglePii" Header="PII Protection" IsOn="False" OnContent="Enabled" OffContent="Disabled" Toggled="TogglePii_Toggled"/>

                            <StackPanel x:Name="PanelPiiStrategy" Spacing="4" Opacity="0.4">
                                <TextBlock Text="PII Strategy" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                                <ComboBox x:Name="ComboPiiStrategy" HorizontalAlignment="Stretch" SelectedIndex="0" IsEnabled="False">
                                    <ComboBoxItem Content="Mask" Tag="mask"/>
                                    <ComboBoxItem Content="Hash" Tag="hash"/>
                                    <ComboBoxItem Content="Block" Tag="block"/>
                                    <ComboBoxItem Content="Partial Masking" Tag="partial masking"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Right column: Execution Console -->
            <Grid Grid.Column="1" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Status & Action Bar -->
                <Border Grid.Row="0" Background="#111827" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Attack Controller" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TextControllerStatus" Text="Ready to initialize adversarial assessment run." FontSize="12" Foreground="#94A3B8"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="BtnStop" Content="Stop Campaign" Click="BtnStop_Click"
                                    Background="#1A1F2E" BorderBrush="#FF2D55" BorderThickness="1"
                                    CornerRadius="6" Padding="14,10" Visibility="Collapsed"/>
                            <Button x:Name="BtnLaunch" Content="Launch Red Team Campaign" Click="BtnLaunch_Click"
                                    Style="{StaticResource AccentButtonStyle}" Background="#FF2D55"
                                    BorderThickness="0" CornerRadius="6" Padding="16,10"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Console Output Terminal -->
                <Border Grid.Row="1" Background="#0A0F1D" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Padding="0,0,0,8" BorderBrush="#19FFFFFF" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="10" Height="10" Fill="#FF2D55"/>
                                <Ellipse Width="10" Height="10" Fill="#FFB800"/>
                                <Ellipse Width="10" Height="10" Fill="#22FF88"/>
                                <TextBlock Text="JGUARD ADVERSARIAL TELEMETRY FEED" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                            <ProgressRing Grid.Column="1" x:Name="TerminalProgressRing" IsActive="False" Width="16" Height="16" Foreground="#FF2D55"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" x:Name="ConsoleScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <TextBox x:Name="TextTerminalLog"
                                     Text="[SYSTEM] Dashboard loaded. Awaiting campaign trigger..."
                                     FontFamily="Consolas" FontSize="12" Foreground="#22FF88"
                                     Background="Transparent" BorderThickness="0"
                                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Progress and Result Panel -->
                <StackPanel Grid.Row="2" Spacing="8">
                    <ProgressBar x:Name="AttackProgressBar" Value="0" Maximum="100" Height="8" CornerRadius="4" Foreground="#FF2D55" Background="#111827"/>

                    <Border x:Name="CardSummary" Background="#111827" BorderBrush="#22FF88" BorderThickness="1.5" CornerRadius="8" Padding="16" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="TextSummaryTitle" Text="Campaign Completed" FontSize="15" FontWeight="Bold" Foreground="#22FF88"/>
                                <TextBlock x:Name="TextSummaryMetrics" Text="" FontSize="12" Foreground="#94A3B8"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Campaign ID:" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TextSummaryId" Text="" FontSize="12" FontWeight="Bold" Foreground="#FF2D55" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
